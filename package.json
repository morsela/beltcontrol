{
  "name": "beltcontrol",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "check": "npm run check --workspaces",
    "lint": "oxlint",
    "test": "npm run test --workspaces",
    "test:watch": "npm run test:watch -w apps/web"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "jsdom": "^25.0.1",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "fsevents": false
  }
}
