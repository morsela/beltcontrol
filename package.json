    "@vercel/analytics": "^2.0.1",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/web-bluetooth": "^0.0.21",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {}
}
