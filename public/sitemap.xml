<?xml version="1.0" encoding="UTF-8"?>
<!-- The app is one URL — the three screens are hash routes off the shell — plus the
     written pages in public/, which are ordinary HTML files and are the only thing here
     a crawler can read without running JavaScript.

     __LASTMOD__ is stamped with the last commit date at build time by the stamp-sitemap
     plugin in vite.config.ts. A hand-written date is wrong from the next commit onwards,
     and a lastmod found stale teaches a crawler to ignore the field on this host. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://beltcontrol.com/</loc>
    <lastmod>__LASTMOD__</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://beltcontrol.com/compatible-treadmills</loc>
    <lastmod>__LASTMOD__</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://beltcontrol.com/walkingpad-without-the-app</loc>
    <lastmod>__LASTMOD__</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://beltcontrol.com/troubleshooting</loc>
    <lastmod>__LASTMOD__</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://beltcontrol.com/walkingpad-bluetooth-protocol</loc>
    <lastmod>__LASTMOD__</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
</urlset>
